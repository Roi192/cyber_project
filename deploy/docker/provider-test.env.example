# OPTIONAL runtime settings for an AUTHORISED live-provider test in the college-test container. Copy to provider-test.env (git-ignored, never baked into an image), fill the keys
# locally, then uncomment env_file in docker-compose.college-test.yml. With this file the application WILL send real requests to the providers whose key and switch you set
# (APIVoid has very few credits left: leave it off). Without it every provider stays unconfigured and the test makes no external request.
# Linux TLS note: the container trusts the normal Ubuntu/certifi roots; a Windows antivirus certificate (REQUESTS_CA_BUNDLE) is not and must not be used here.
VT_API_KEY=
GSB_ENABLED=false
GSB_API_KEY=
OTX_ENABLED=false
OTX_API_KEY=
URLSCAN_ENABLED=false
URLSCAN_API_KEY=
APIVOID_ENABLED=false
APIVOID_API_KEY=
METADEFENDER_ENABLED=false
METADEFENDER_API_KEY=
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
