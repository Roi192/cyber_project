**/agent.env
**/*.db
**/*.db-journal
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/data
**/backups
**/logs
**/*.log
**/venv
**/.venv
**/__pycache__
**/*.pyc
**/.git
**/.gitignore
**/*.pem
**/*.crx
**/*.key
**/ca-bundle.pem
**/tests
**/agent
**/browser_extension
**/dist
**/*.tar.gz
**/*.zip
cyber_project_college_private
docker_test/*.env
