# Website Monitor - settings for the COLLEGE server (account team2, /home/team2/cyber_project).  SAFE EXAMPLE: it contains no secret.
#
# You normally do NOT create this file by hand:
#   * if you copy your private .env into this folder before the first start, that file is used as it is;
#   * if there is no .env, `python app.py` creates one from this template with a new random SECRET_KEY and API_KEY (provider keys stay empty).
# Never put a real key into a file that is copied around, e-mailed, zipped without a password or committed. See README.md ("Your private .env").
# A source is used only when its key is present AND its *_ENABLED switch is true. A source that is off, has no key, is blocked by the network or has used its budget is shown
# as unavailable on the dashboard; everything else keeps working.

# --- where it listens ---
# 127.0.0.1 = this server only (open the dashboard in a browser on the server, or through an SSH tunnel). 0.0.0.0 = every network interface; API_KEY (below) is then required.
HOST=127.0.0.1
PORT=5002
# 1 only when a reverse proxy (Apache) forwards to this server on the same machine.
TRUSTED_PROXY_HOPS=0

# --- secrets: generated automatically on first start when empty; never type them here for the example ---
SECRET_KEY=
API_KEY=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
SESSION_COOKIE_SECURE=false

# --- the college database is its OWN file, created empty on first start (never a copy of the Windows data) ---
DATABASE_PATH=data/monitoring.db
RETENTION_DAYS=30
REPUTATION_CACHE_HOURS=24

# --- the demonstration runs the legacy alert policy; the proposed policy is only compared in Shadow Mode ---
SEVERITY_POLICY=legacy

# --- the seven sources. Scoring: VirusTotal, Google Safe Browsing, AlienVault OTX, urlscan.io. Observation only (shown, never decisive): APIVoid, MetaDefender Cloud, AbuseIPDB ---
VT_API_KEY=
VT_MAX_PER_MINUTE=3
VT_MAX_PER_DAY=450
GSB_ENABLED=false
GSB_API_KEY=
GSB_MAX_PER_MINUTE=10
GSB_MAX_PER_DAY=1000
OTX_ENABLED=false
OTX_API_KEY=
OTX_MAX_PER_MINUTE=10
OTX_MAX_PER_DAY=1000
URLSCAN_ENABLED=false
URLSCAN_API_KEY=
URLSCAN_MAX_PER_MINUTE=5
URLSCAN_MAX_PER_DAY=300
APIVOID_ENABLED=false
APIVOID_API_KEY=
APIVOID_MAX_PER_MINUTE=1
APIVOID_MAX_PER_DAY=2
METADEFENDER_ENABLED=false
METADEFENDER_API_KEY=
METADEFENDER_MAX_PER_MINUTE=2
METADEFENDER_MAX_PER_DAY=100
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_PER_MINUTE=5
ABUSEIPDB_MAX_PER_DAY=300
