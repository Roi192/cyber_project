#: app.py:1067
msgid "Invalid username or password"
msgstr "שם משתמש או סיסמה שגויים"

#: app.py:1106
#, python-format
msgid ""
"Account temporarily locked. Try again in approximately %(minutes)s "
"minute(s)."
msgstr "החשבון ננעל זמנית. נסו שוב בעוד כ-%(minutes)s דקות."

#: app.py:1241
#, python-format
msgid "Too many failed login attempts. Account locked for %(minutes)s minutes."
msgstr "יותר מדי ניסיונות התחברות כושלים. החשבון ננעל ל-%(minutes)s דקות."

#: app.py:1276
#, python-format
msgid "Invalid username or password. %(attempts_left)s attempt(s) remaining."
msgstr "שם משתמש או סיסמה שגויים. נותרו %(attempts_left)s ניסיונות."

#: app.py:3230
msgid "Only a NEW alert can be acknowledged."
msgstr "ניתן לאשר קבלה רק להתראה חדשה."

#: app.py:3258
msgid "Alert acknowledged."
msgstr "ההתראה אושרה."

#: app.py:3265
msgid "This alert cannot be closed from its current status."
msgstr "לא ניתן לסגור התראה זו מהסטטוס הנוכחי שלה."

#: app.py:3288
msgid "Alert closed."
msgstr "ההתראה נסגרה."

#: app.py:3295
msgid "This alert is already escalated to an incident."
msgstr "התראה זו כבר הוסלמה לאירוע."

#: app.py:3302
msgid "A closed alert cannot be escalated in this phase."
msgstr "לא ניתן להסלים התראה סגורה בשלב זה."

#: app.py:3324
#, python-format
msgid "Alert escalated to Incident #%(id)s."
msgstr "ההתראה הוסלמה לאירוע מספר %(id)s."

#: app.py:3373
msgid "This alert has no destination to block/unblock."
msgstr "אין להתראה זו יעד לחסימה/ביטול חסימה."

#: app.py:3380
msgid "This alert has no associated endpoint."
msgstr "אין להתראה זו מחשב משויך."

#: app.py:3399 app.py:4021
msgid ""
"This endpoint is not a recognized managed endpoint and cannot be "
"isolated/restored."
msgstr "מחשב זה אינו מחשב מנוטר מוכר ולא ניתן לבודד/לשחזר אותו."

