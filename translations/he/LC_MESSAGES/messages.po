msgstr "חסימה אינה זמינה כרגע מכיוון שאירוע זה אינו משויך למחשב מנוטר."

#: app.py:3987
msgid "This incident has no associated endpoint."
msgstr "אין לאירוע זה מחשב משויך."

#: app.py:4067
#, python-format
msgid "%(command_label)s requested (command #%(command_id)s)."
msgstr "הפעולה \"%(command_label)s\" התבקשה (פקודה מספר %(command_id)s)."

