# Website Monitor network agent - configuration. Copy to agent.env (it is git-ignored and
# never part of the deployment archive) and edit. Never commit the real file.
#
# Every value can also be set as an environment variable with the prefix WMA_ (for example
# WMA_API_KEY), which wins over this file. The prefix stops an unrelated API_KEY on the
# machine from being picked up by accident.

# Central server address (http:// or https:// only).
SERVER_URL=http://127.0.0.1:5002

# The organization API key (the same value as API_KEY in the server's .env). Leave empty only
# while testing against a server in development mode. It is never printed or logged.
API_KEY=

# Name shown on the dashboard. Empty = this computer's Windows name.
COMPUTER_NAME=

# Optional label for the person who uses this computer. It is a label you choose, not a Windows
# account. Empty = nothing is sent.
USER_LABEL=

# OPTIONAL. Leave empty and the agent creates its own permanent random identity (kept in
# agent_state.json). Fill it in ONLY to deliberately link this agent to the browser extension of
# the same computer: paste the extension's Installation ID (extension options, Technical details)
# so the server shows one computer. A matching computer name alone never links anything.
ENDPOINT_UID=

# Which collector to use (all work without administrator rights):
#   auto    native, and the DNS-cache collector only if the native one cannot start (default)
#   native  the Windows TCP connection table: which program connects to which public IP address,
#           Chrome and Edge included. About 16 MB of memory. No website names.
#   dns     the Phase 5.1 collector: domain names from the Windows DNS cache. Chrome and Edge
#           browsing is not visible to it. About 115 MB more memory (a PowerShell process).
COLLECTOR=auto

# Native collector: how often the connection table is read, in milliseconds (100-5000). A faster
# poll misses fewer short connections and costs a little more CPU (see agent/README.md).
NATIVE_POLL_MS=250

# Browser-history fallback (Chrome and Edge, this Windows user, no administrator rights): when the browser extension is
# missing or silent, the agent reads NEW visits from the browser's own history file, strictly read-only, and sends only the
# HOST NAME (for example www.sqlite.org): never a path, query, title or search term. Visits already in the history when the
# agent starts are never sent. Private/incognito windows are not recorded by browsers, so they are not covered.
#   on   (default)   off = do not read any browser history
HISTORY_WATCH=on
# How often the histories are checked, in seconds (5-120). Browsers write a visit about 10 s after it happens.
HISTORY_POLL_SECONDS=12
# Only for a non-standard install: the browser's "User Data" folder. Empty = the standard place of this Windows user.
HISTORY_CHROME_ROOT=
HISTORY_EDGE_ROOT=

# DNS-cache collector only: how often the Windows DNS cache is read, in seconds (5-300).
POLL_SECONDS=10

# How often the agent says "I am online", in seconds (15-300). The server shows the computer as
# online for 3 minutes after the last beat.
HEARTBEAT_SECONDS=60

# Where the permanent identity is stored. Empty = agent_state.json next to this file.
STATE_FILE=
