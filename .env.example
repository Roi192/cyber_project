# Copy to .env and adjust. Never commit .env (it is git-ignored and is not part of the
# deployment archive). Verify it with:  python deploy/check_env.py   (prints no secrets)
# For local development an empty API_KEY is enough; for a network deployment API_KEY
# MUST be set.

# Used ONLY by "python app.py" (development server). With Gunicorn use --bind
# (for example --bind 0.0.0.0:5002) instead.
# Default 127.0.0.1 = this computer only. 0.0.0.0 makes the server reachable from the network and then API_KEY below is REQUIRED:
# the application refuses to start without it.
HOST=127.0.0.1
PORT=5002

# Signs the administrator sign-in sessions. REQUIRED: at least 24 characters and not a placeholder, otherwise the application
# refuses to start. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Administrator sessions: signed out after this many minutes without a click, and in any case after this many hours.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8
# Set to true when the dashboard is served over HTTPS, so the session cookie is never sent over plain HTTP.
SESSION_COOKIE_SECURE=false

# Organization-wide key every browser extension sends in the X-Api-Key header
# (register, heartbeat, web events, connection test). REQUIRED when the server
# is reachable from a network. Empty = DEV MODE (no authentication, development
# only; a warning is shown). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Never commit the real value; .env is git-ignored.
API_KEY=

# How many reverse proxies (Apache ProxyPass) sit in front of Gunicorn. 0 = none (the default, and the only safe value when clients can reach Gunicorn
# directly, because the X-Forwarded-* headers can then be forged). 1 = Apache forwards to Gunicorn on this machine: the real client address, the https scheme and a
# /prefix (header X-Forwarded-Prefix) are taken from Apache's headers. Leave Gunicorn bound to 127.0.0.1 in that case. See deploy/COLLEGE_TEAM2.md.
TRUSTED_PROXY_HOPS=0

# Where Gunicorn listens (read by deploy/service.sh; optional). The default 127.0.0.1:5002 is right behind Apache. For a demonstration WITHOUT Apache use
# 0.0.0.0:5002 (the port must then be reachable from the other computers, and API_KEY above must be set).
# GUNICORN_BIND=127.0.0.1:5002

# How many VirusTotal lookups the application may start per minute and per day, all sources together (the free key allows 4 and 500). Over the budget a website is shown
# as "Not checked yet" and looked up later; it is never reported safe.
VT_MAX_PER_MINUTE=3
VT_MAX_PER_DAY=450

# Extra reputation sources. Both are OFF by default. To use one: set its flag to true AND fill its credential, then restart the server. Without a credential the source is
# reported as "not configured" (never as safe). Limits are per source, shared by the extension and the agent; the defaults are conservative guesses, check your own quota.
# Google Safe Browsing: a Google Cloud API key with the Safe Browsing API enabled (non-commercial use only). Only 4-byte hash prefixes of the website name leave this computer.
# --- Threat-intelligence sources: key once, switch on, restart. VirusTotal (VT_API_KEY) needs no switch; the other four need their key AND their *_ENABLED=true. ---
GSB_ENABLED=false
GSB_API_KEY=
GSB_MAX_PER_MINUTE=10
GSB_MAX_PER_DAY=1000
# Phase F3.22, OBSERVATION-ONLY sources (stored and shown, never part of a verdict, risk score or alert). Each needs its flag AND its key. The limits are conservative defaults:
# set them to what your plan really allows. See docs/PROVIDERS_F322.md.
# APIVoid (the API behind URLVoid): domain reputation, blacklists. Key from https://www.apivoid.com (sent in the X-API-Key header). Only the website NAME is sent.
APIVOID_ENABLED=false
APIVOID_API_KEY=
APIVOID_MAX_PER_MINUTE=2
APIVOID_MAX_PER_DAY=30
# OPSWAT MetaDefender Cloud: domain reputation. Key from https://metadefender.opswat.com (sent in the apikey header). Only the website NAME is sent.
METADEFENDER_ENABLED=false
METADEFENDER_API_KEY=
METADEFENDER_MAX_PER_MINUTE=2
METADEFENDER_MAX_PER_DAY=100
# AbuseIPDB: reputation of the PUBLIC IP ADDRESS the website resolves to (never of the website itself; a shared CDN or hosting address proves nothing about a site). Key from
# https://www.abuseipdb.com (sent in the Key header). Only validated public addresses are sent.
ABUSEIPDB_ENABLED=false
ABUSEIPDB_API_KEY=
ABUSEIPDB_MAX_PER_MINUTE=5
ABUSEIPDB_MAX_PER_DAY=300
# AlienVault OTX (Phase F3.12): a free key from https://otx.alienvault.com (Settings, "OTX Key"). Only the website NAME is sent. A pulse that mentions a site is community
# context, never proof; OTX alone can raise at most a MEDIUM alert.
OTX_ENABLED=false
OTX_API_KEY=
OTX_MAX_PER_MINUTE=10
OTX_MAX_PER_DAY=1000
# urlscan.io (Phase F3.12): searches EXISTING public scans of the website name; the application never submits a scan. The key is optional (searches work without one with small
# quotas; a free key from https://urlscan.io/user/signup raises them).
URLSCAN_ENABLED=false
URLSCAN_API_KEY=
URLSCAN_MAX_PER_MINUTE=5
URLSCAN_MAX_PER_DAY=300

# Alert policy for reputation answers: legacy (default) or evidence (weak single-engine findings are shown for investigation but raise no alert; thresholds in
# services/evidence.py). Leave on legacy until the evidence policy has been approved.
SEVERITY_POLICY=legacy

# SQLite file (created automatically with a NEW empty database on first start).
# Relative paths are inside the project folder; an absolute path is used as given.
# The running user must be able to write there, on a local disk (not NFS).
DATABASE_PATH=data/monitoring.db

# Delete web visits older than this many days when the dashboard is opened (0 = keep forever)
RETENTION_DAYS=30

# How long a Safe verdict stays valid before re-checking (hours)
REPUTATION_CACHE_HOURS=24

# Optional external reputation provider (VirusTotal v3 API key).
# Without a key (or while it is rate limited) visits are still stored and shown as
# "Not checked", and the dashboard says Limited visibility - nothing is claimed safe.
VT_API_KEY=
