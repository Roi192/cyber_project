# Copy to .env and adjust. Never commit .env (it is git-ignored and is not part of the
# deployment archive). Verify it with:  python deploy/check_env.py   (prints no secrets)
# For local development an empty API_KEY is enough; for a network deployment API_KEY
# MUST be set.

# Used ONLY by "python app.py" (development server). With Gunicorn use --bind
# (for example --bind 0.0.0.0:5002) instead.
HOST=0.0.0.0
PORT=5002

# Flask session secret. Currently unused (the app has no sessions) - set a random value anyway.
SECRET_KEY=change-me

# Organization-wide key every browser extension sends in the X-Api-Key header
# (register, heartbeat, web events, connection test). REQUIRED when the server
# is reachable from a network. Empty = DEV MODE (no authentication, development
# only; a warning is shown). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
# Never commit the real value; .env is git-ignored.
API_KEY=

# SQLite file (created automatically with a NEW empty database on first start).
# Relative paths are inside the project folder; an absolute path is used as given.
# The running user must be able to write there, on a local disk (not NFS).
DATABASE_PATH=data/monitoring.db

# Delete web visits older than this many days when the dashboard is opened (0 = keep forever)
RETENTION_DAYS=30

# How long a Safe verdict stays valid before re-checking (hours)
REPUTATION_CACHE_HOURS=24

# Optional external reputation provider (VirusTotal v3 API key).
# Without a key (or while it is rate limited) visits are still stored and shown as
# "Not checked", and the dashboard says Limited visibility - nothing is claimed safe.
VT_API_KEY=
