# Copy to .env and adjust. Nothing here is required to start the app.

# Network (the college Linux server uses 0.0.0.0:5002)
HOST=0.0.0.0
PORT=5002

# Flask session secret - change in any real deployment
SECRET_KEY=change-me

# Shared key that endpoints must send in the X-Api-Key header on POST
# requests. Leave empty to disable the check (development only).
API_KEY=

# SQLite file (created automatically, relative to the project folder)
DATABASE_PATH=data/monitoring.db

# Delete web visits older than this many days (0 = keep forever)
RETENTION_DAYS=30

# How long a domain reputation verdict stays valid before re-checking
REPUTATION_CACHE_HOURS=24

# Optional external reputation provider (VirusTotal v3 API key).
# Without a key every unknown domain is reported as UNKNOWN - no
# malicious-site detection is claimed.
VT_API_KEY=
