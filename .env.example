# ==================================================
# Cyber Security Monitoring & Response Platform
# Environment configuration template
# ==================================================
# Copy this file to `.env` in the same directory and fill in real
# values. Never commit the real `.env` file (already in
# .gitignore). This file contains placeholders only - no real
# secrets.
#
#   cp .env.example .env        (Linux/Kali)
#   copy .env.example .env      (Windows)

# --------------------------------------------------
# REQUIRED - Flask session security
# --------------------------------------------------
# Signs session cookies. The app refuses to start outside debug
# mode without this set. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=CHANGE_ME

# --------------------------------------------------
# REQUIRED - Agent API authentication
# --------------------------------------------------
# Shared secret the SOC server requires from every endpoint agent
# (X-Agent-Key header). Without this set, /api/web-events and the
# agent command API fail closed (503) for every request. Generate
# with the same command as above.
AGENT_API_KEY=CHANGE_ME

# --------------------------------------------------
# OPTIONAL - Threat intelligence providers
# --------------------------------------------------
# If left blank, reputation lookups for that provider are skipped
# and the risk engine runs with reduced enrichment from the other
# configured source(s) - the system does not fail to start.
VT_API_KEY=
ABUSEIPDB_API_KEY=

# Phase 12B.3: normalized VirusTotal evidence (context only, zero Threat
# Risk contribution) reuses VT_API_KEY above - no new key. The defaults
# below are safe for the VirusTotal Public API (4 requests/min,
# 500/day) and only need changing with a licensed higher quota. Legacy
# VirusTotal IP lookups share this same key/quota, so they are counted
# toward these budgets (set VT_COUNT_LEGACY_USAGE=0 only if the legacy
# path has its own quota).
# VT_MAX_CALLS_PER_MINUTE=3
# VT_MAX_CALLS_PER_DAY=450
# VT_COUNT_LEGACY_USAGE=1

# Phase 11D.1: ThreatFox (abuse.ch) contextual threat intelligence.
# Free Auth-Key from https://auth.abuse.ch/ - if left blank, every
# ThreatFox lookup is recorded as a non-fatal ERROR/config-
# unavailable state (no HTTP request is ever made) and the rest of
# the platform (Threat Risk, Behavioral Baseline, Alerts) is
# entirely unaffected.
THREATFOX_API_KEY=

# Phase 12B.2: URLhaus (abuse.ch) contextual threat intelligence -
# same multi-provider framework as ThreatFox, context-only, ZERO Threat
# Risk contribution. Free Auth-Key from https://auth.abuse.ch/ - if
# left blank, threat_intel_worker.py records every URLhaus lookup as
# NOT_CONFIGURED (no HTTP request is ever made) and the rest of the
# platform is entirely unaffected. MANUAL CONFIGURATION REQUIRED if you
# want live URLhaus enrichment - this key was not present in .env at
# the time Phase 12B.2 was implemented, so it was left blank rather
# than fabricated.
URLHAUS_API_KEY=

# Phase 12B.5B: Cloudflare Threat Intelligence (IP + Domain Intelligence
# ONLY). MANUAL, ON-DEMAND, CACHE-FIRST and CONTEXT-ONLY: requests are made
# solely when an analyst presses "Investigate with Cloudflare" (never by
# the workers, never on page load), results are cached for 7 days, and
# they never affect Threat Risk, Investigation Priority, Alerts,
# Incidents or Response. Use a least-privilege API token with the
# account-scoped "Intel Read" permission only. CLOUDFLARE_ACCOUNT_ID is
# the 32-character lowercase hex account ID. CLOUDFLARE_TI_MONTHLY_BUDGET
# is this APPLICATION's own rolling-30-day call budget (default 80); the
# real Cloudflare quota (100/month on Free/Pro/Business) is shared with
# Cloudflare's dashboard features and is not visible to this application.
# If either the token or the account ID is blank the feature reports
# "not configured" and makes no request.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TI_MONTHLY_BUDGET=80

# Phase 12B.1: name reserved for a future provider not yet implemented
# (no code reads it, no HTTP request is ever made against it).
UMBRELLA_INVESTIGATE_API_TOKEN=

# --------------------------------------------------
# Oct 2026 request: 8 additional threat-intelligence providers. All 8
# adapters are implemented and live-wired (see otx_provider.py,
# greynoise_provider.py, google_safe_browsing_provider.py,
# phishtank_provider.py, urlscan_provider.py, ipqualityscore_provider.py,
# shodan_provider.py, censys_provider.py) - each is reported "not
# configured" and makes no request ONLY while its key below is blank (for
# the 3 marked "keyless" below, it is already active WITHOUT a key - set
# the key only to raise that provider's own rate limit). Run
# `python threat_intel_diagnostics.py status` to see every provider's live
# configuration/connection status (never prints a key value).
# --------------------------------------------------

# AlienVault OTX - https://otx.alienvault.com/api
# malicious_evidence (community "Pulse" IOC matches), Automatic. KEYLESS:
# already works without a key (1,000 lookups/hour, shared); a key raises
# the ceiling to 10,000/hour.
OTX_API_KEY=

# GreyNoise Community API - https://viz.greynoise.io/account/api-key
# malicious_evidence (only its "malicious" scanner classification -
# "benign"/"unknown" never lower risk), Manual only (quota too tight for
# automatic dispatch). KEYLESS: already works without a key (10 lookups/
# day); a free Community key raises this to 50/week.
GREYNOISE_API_KEY=

# Google Safe Browsing - https://developers.google.com/safe-browsing/v4/get-started
# malicious_evidence, decisive (direct phishing/malware verdict from
# Google's own list), Manual only. A KEY IS REQUIRED - get one from the
# Google Cloud Console (enable the "Safe Browsing API" on a project, then
# create an API key under "Credentials").
GSB_API_KEY=

# PhishTank - https://phishtank.org/api_register.php
# malicious_evidence, decisive (community-verified confirmed phishing
# URLs), Manual only. KEYLESS: the public API already works without a
# key (doc-confirmed optional); a key only raises the rate limit.
PHISHTANK_API_KEY=

# urlscan.io - https://urlscan.io/user/signup
# context_only (scan/investigation enrichment, never a verdict), Manual
# only, search-only (never auto-submits a URL for scanning). KEYLESS:
# searching existing results already works without a key, at a reduced
# quota; a key raises it.
URLSCAN_API_KEY=

# IPQualityScore - https://www.ipqualityscore.com/create-account
# malicious_evidence, never decisive alone (commercial fraud/risk score
# and proxy/VPN detection), Automatic once configured. A KEY IS REQUIRED.
IPQS_API_KEY=

# Shodan - https://account.shodan.io/register
# context_only (exposed ports/services are NEVER independent evidence of
# malicious activity on their own), Manual only. A KEY IS REQUIRED.
SHODAN_API_KEY=

# Censys - https://search.censys.io/register
# context_only (same rule as Shodan), Manual only. Censys v2 authenticates
# with an API ID + API Secret pair (HTTP Basic) - BOTH ARE REQUIRED; get
# them from your Censys account page. NOTE: this adapter's exact endpoint/
# response shape has LOWER CONFIDENCE than the others (Censys's own
# primary docs could not be fetched directly at implementation time - see
# censys_provider.py's module header) - re-verify before relying on it.
CENSYS_API_ID=
CENSYS_API_SECRET=

# --------------------------------------------------
# THREAT INTEL SHADOW MODE (Oct 2026 Step 7)
# --------------------------------------------------
# Controls ONLY whether web_event_worker.py's background Shadow Mode
# evaluation (threat_intel_shadow.evaluate_shadow) runs during live event
# processing. Disabled (false/unset, the default) means: zero behaviour
# change from this feature not existing - no extra DB connection, no extra
# read, no row written anywhere. Enabled means: a comparison row (legacy
# score/severity vs. what the new corroboration engine would contribute)
# is written to a SEPARATE database file - never cybersec.db, never read
# by any block/isolate/alert/incident decision. Either way this setting
# NEVER changes risk_score, severity, decision, alerts, or any automatic
# response action - see threat_intel_shadow.py's module docstring for the
# full list of hard guarantees. A running worker process only picks up a
# change to this value when it is restarted.
THREAT_INTEL_SHADOW_MODE_ENABLED=false

# --------------------------------------------------
# THREAT INTEL - ALIENVAULT OTX AUTOMATIC ACTIVATION (Oct 2026 Step 10)
# --------------------------------------------------
# Controls ONLY whether threat_intel_worker.py's automatic background
# cycle includes "alienvault_otx" in its managed-provider list at all.
# Default DISABLED - with no key and this unset/false, OTX never makes a
# live call (it works keyless, same as GreyNoise/PhishTank/urlscan.io,
# but is not scheduled automatically unless explicitly turned on here).
# The first cycle after enabling applies a small, one-time gradual-
# rollout cap (5 calls) before the normal per-cycle budget resumes - see
# threat_intel_worker.py's OTX_FIRST_CYCLE_LIMIT. A running worker process
# only picks up a change to this value when it is restarted.
OTX_ENABLED=false

# --------------------------------------------------
# DEVELOPMENT - Flask runtime
# --------------------------------------------------
# FLASK_DEBUG=true enables the Werkzeug debug reloader and verbose
# error pages - development only, never use in a real deployment.
# Defaults to false (safe) if this line is omitted entirely.
FLASK_DEBUG=false

# 127.0.0.1 = local-only access. Use 0.0.0.0 only for a
# LAN classroom demo, and only on a network you trust - see
# README "Network Binding for Lab Use".
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --------------------------------------------------
# PRODUCTION - Cookie security
# --------------------------------------------------
# Set to true only when the app is served over real HTTPS
# (directly or behind a reverse proxy). If true over plain HTTP,
# the browser will silently refuse to send the session cookie and
# login will appear broken - this is not a bug, it is the browser
# enforcing the Secure cookie flag.
FLASK_SECURE_COOKIES=false

# --------------------------------------------------
# OPTIONAL - Response action enforcement (endpoint agent side)
# --------------------------------------------------
# false (default) = every Block/Isolate/Unblock/Restore command is
# reported back as SIMULATED, no OS/firewall change is made - safe
# for any machine, including this SOC server itself.
# true = the endpoint agent will actually modify the Windows
# Firewall when it receives a command. Only ever set this on a
# Windows lab machine you control, running as Administrator, with
# restore_network.py available for emergency rollback. Has no
# effect on the SOC server itself - this variable belongs in the
# ENDPOINT AGENT's own .env, not the server's.
ENABLE_RESPONSE_ACTIONS=false

# Stage 25G: a SEPARATE, second gate for AUTONOMOUS response - may the
# SOC server create a response command WITHOUT an analyst approving
# the response plan first. Checked server-side (response_gate.py) and
# never equated with ENABLE_RESPONSE_ACTIONS: autonomous dispatch needs
# BOTH to be true. Absent/false = every plan needs an analyst. Keep
# false unless a dry-run period has been reviewed and approved.
ENABLE_AUTONOMOUS_RESPONSE=false

# Optional, comma-separated, for response_policy.py's protection model
# (defaults are a small, justified built-in set - see that module):
#   RESPONSE_PROTECTED_ENDPOINT_UIDS, RESPONSE_PROTECTED_PROCESSES,
#   RESPONSE_PROTECTED_PATH_FRAGMENTS, RESPONSE_ALLOWED_DESTINATIONS

# --------------------------------------------------
# OPTIONAL - Windows endpoint agent only
# --------------------------------------------------
# Where the endpoint agent sends telemetry. Point this at the SOC
# server's real LAN IP for a cross-machine demo (Windows agent ->
# Linux SOC server), e.g. http://192.168.1.50:5000 - never commit
# a real classroom IP, keep it in the agent's local .env only.
SOC_SERVER_URL=http://127.0.0.1:5000

# --------------------------------------------------
# REQUIRED ONLY on first run against an empty database
# --------------------------------------------------
# If the users table is already empty, these two values create the
# first admin account automatically at startup. If either is left
# blank and the users table is empty, no admin is created and a
# warning is printed - the app still starts, but nobody can log in
# until an admin exists (see README "Initial Admin Bootstrap").
# Ignored entirely once at least one user already exists.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME

# --------------------------------------------------
# OPTIONAL - Alternate database file
# --------------------------------------------------
# Selects which SQLite file the server AND worker use - both must
# be started with the same value. Leave unset/blank for the normal
# development database (cybersec.db, in this project directory).
# Used to point at a separate classroom demo database instead - see
# README "Classroom Demo Database" and prepare_demo_db.py. A
# relative value resolves against this project's own directory; an
# absolute path is used as-is.
# SOC_DB_PATH=cybersec_demo.db

# --------------------------------------------------
# SQLITE RELIABILITY (Phase 12B.6C.1) - all optional
# --------------------------------------------------
# Defaults are deliberate and shared by the app and every worker
# (db_config.py). Change them only with a measured reason.
#
# Journal mode. WAL (default) lets readers and the writer run concurrently
# and is set once, persistently, at start-up. Use DELETE only to opt out.
# NOTE for backups: with WAL, copy the database with SQLite's backup API /
# `sqlite3 cybersec.db ".backup out.db"` (or include the -wal file); a bare
# file copy of cybersec.db while the app is running can miss recent commits.
# SOC_DB_JOURNAL_MODE=WAL
#
# How long one statement waits for a lock before failing (default 15000).
# Tolerates short contention; deliberately not long enough to hide a
# multi-minute stuck transaction.
# SOC_DB_BUSY_TIMEOUT_MS=15000
#
# Bounded retries a worker makes on a transient "database is locked"
# (default 5, exponential back-off starting at 0.5 s), after which the item
# is deferred and the worker keeps running.
# SOC_DB_LOCK_RETRY_ATTEMPTS=5
# SOC_DB_LOCK_RETRY_BASE_DELAY=0.5
#
# Worker health: each worker writes worker_status/<name>.json; check with
#   python worker_status.py
# SOC_WORKER_STATUS_DIR=worker_status

# --------------------------------------------------
# STABLE AGENT IDENTIFIER (Phase 12B.6D) - endpoint agent side, optional
# --------------------------------------------------
# On first start each managed endpoint agent generates a random UUIDv4 and
# stores it in a small local state file (default: endpoint_agent_state.json
# next to endpoint_agent_stable.py). It survives restarts and IP changes,
# is sent with every event as "endpoint_uid", contains no secret and is NOT
# an authentication credential (X-Agent-Key still authenticates every
# request). Deleting the file makes the installation look like a NEW
# endpoint. A malformed file is set aside as <file>.corrupt-<timestamp>.
# AGENT_STATE_FILE=endpoint_agent_state.json

# --------------------------------------------------
# SECURITY DATA FOUNDATION (Phase 13B) - external sensors
# --------------------------------------------------
# Server-side PEPPER for sensor credential verification:
#   verifier = HMAC-SHA256(pepper, sensor_id + sensor_secret)
# Only the verifier is stored in cybersec.db; the pepper is NEVER stored in the
# database, logs, reports or pages. Generate a dedicated random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# It must be >= 32 characters and must NOT be (or contain) FLASK_SECRET_KEY,
# AGENT_API_KEY, any provider key or any other secret. If it is unset or unsafe,
# sensor creation, rotation and authentication FAIL CLOSED (POST
# /api/security-ingest answers 503); nothing else in the platform is affected.
# BACKUP / RECOVERY: the pepper is deliberately not in database backups. Losing it
# (or restoring a database with a different pepper) makes every sensor credential
# unverifiable - restore the pepper from your own secret store, or rotate every
# sensor secret with sensor_admin.py. Keep it backed up SEPARATELY from the database.
SENSOR_CREDENTIAL_PEPPER=

# Where normalized OBSERVATIONS are stored (one SQLite file per UTC day,
# telemetry_YYYYMMDD.db). Default: data/telemetry next to the application.
# Never the main database directory's file. Structured ingest log: SECURITY_LOG_DIR
# (default data/logs).
# SECURITY_TELEMETRY_DIR=data/telemetry
# SECURITY_LOG_DIR=data/logs

# Late-arrival window: observed_at older than this many days is REJECTED, and a
# telemetry day file older than this is sealed (never written again). Default 7.
# Tolerated clock skew for observed_at in the future, in seconds. Default 300.
# SECURITY_MAX_PAST_DAYS=7
# SECURITY_MAX_FUTURE_SECONDS=300

# Telemetry retention (foundation only): OFF by default and never run
# automatically. `python telemetry_admin.py retention --dry-run` shows what would
# be removed. Only telemetry_YYYYMMDD.db files older than the retention days can
# ever be removed; never cybersec.db. Days is never less than
# SECURITY_MAX_PAST_DAYS + 1.
TELEMETRY_RETENTION_ENABLED=false
TELEMETRY_RETENTION_DAYS=14

# Extra engine names (comma-separated, [a-z][a-z0-9_]{1,31}) a sensor may be
# registered for, beyond the built-in registry. No code or schema change needed.
# SECURITY_EXTRA_ENGINES=

# --------------------------------------------------
# ENDPOINT NETWORK CONTEXT / IP HISTORY (Phase 13C) - all optional
# --------------------------------------------------
# The endpoint agent sends a small heartbeat (endpoint_uid + its current
# eligible local addresses) so endpoint IP history stays accurate. It carries
# NO processes, files or browsing data. Agent side:
# ENDPOINT_HEARTBEAT_SECONDS=60
# Adapter-name regex (case-insensitive) of virtual/hypervisor/container adapters
# whose addresses are NOT reported (they repeat across hosts and would produce
# false matches). VPN adapters are kept. Agent side:
# AGENT_EXCLUDE_ADAPTER_PATTERNS=vEthernet|VMware|VirtualBox|Hyper-V|docker|WSL|Loopback|Teredo|isatap|Bluetooth
#
# Server side (defaults justified by the 60 s heartbeat):
# A new observation within this gap EXTENDS the latest interval, otherwise a
# new interval starts (an endpoint never claims the time it was away).
# ENDPOINT_HISTORY_CONTINUITY_GAP_SECONDS=300
# An interval is ACTIVE at t when first_seen - PRE <= t <= last_seen + POST.
# ENDPOINT_RESOLVE_PRE_GRACE_SECONDS=60
# ENDPOINT_RESOLVE_POST_GRACE_SECONDS=120
# A known association older than this is UNKNOWN instead of STALE.
# ENDPOINT_STALE_HORIZON_DAYS=30
# At most one history write per (endpoint, IP) per this many seconds.
# ENDPOINT_HISTORY_WRITE_MIN_SECONDS=30
# How long after its last observation an endpoint UID stays 'bound' to an IP for
# the identity-consistency guard (never shorter than PRE+POST). Default: the
# continuity gap.
# ENDPOINT_IDENTITY_BINDING_SECONDS=300

# --------------------------------------------------
# PHASE 14B: NETWORK SENSOR ENDPOINT RESOLUTION (server side, opt-in)
# --------------------------------------------------
# Comma-separated CIDRs of the NETWORKS this platform monitors (the "internal"
# side) - you configure networks, never individual endpoint IPs.
# UNSET or EMPTY = resolution disabled (records stay NOT_ATTEMPTED).
# ANY malformed entry (or a catch-all such as 0.0.0.0/0) rejects the WHOLE setting:
# resolution stays disabled and a config error is logged / shown on /security-data.
# It never falls back to "all networks". Prefixes broader than /8 (IPv4) or /16
# (IPv6) are refused. SECURITY_MONITORED_NETWORKS is accepted as an alias; when both
# are set, MONITORED_NETWORKS wins. The value is read at process start (restart the
# app after changing it).
# Per NETWORK record: internal->external resolves the source, external->internal
# resolves the destination, internal<->internal reports BOTH sides in server-owned
# metadata and leaves the endpoint slot empty, external<->external is untouched.
# Only an EXACT result attaches an endpoint_uid. Examples (illustrative only):
# MONITORED_NETWORKS=192.168.10.0/24,10.20.10.0/24,2001:db8:10::/64

# --------------------------------------------------
# PHASE 14C: TRUSTED REVERSE PROXY (server side, opt-in, default OFF)
# --------------------------------------------------
# Number of reverse proxies in FRONT of this application that append to X-Forwarded-For.
# 0 / unset / invalid = X-Forwarded-For is IGNORED and the TCP peer is used (the lab default; keep it 0
# unless a TLS-terminating proxy you control really is in front and overwrites the header). Max 5.
# Adapter-side transport settings (SOC_CA_FILE, SOC_REQUIRE_HTTPS) live in the ADAPTER's env file, see
# sensors/vm/adapter.env.example and docs/SURICATA_SENSOR_HARDENING.md.
# SECURITY_TRUSTED_PROXY_HOPS=0

# --------------------------------------------------
# STEP 24B.2E: LOCAL THREAT INTELLIGENCE SCHEDULER (opt-in, default OFF)
# --------------------------------------------------
# Controls ONLY whether local_feed_scheduler.py's main loop does
# anything at all. Unset/not exactly "true" (the default): the process
# prints one line and exits immediately - merely running `python
# local_feed_scheduler.py` (e.g. accidentally) does nothing. This has
# NOT been activated as of Step 24B.2E - see that step's own report.
# Even when enabled, only providers whose registry entry has
# automatic_eligible=True AND whose own `enabled` flag (local_feed_
# attempt_store.LocalFeedAttemptStore) is true are ever downloaded;
# every provider defaults to enabled=True but automatic_eligible=False
# until a provider's registry entry says otherwise. A download never
# changes risk_score/severity/decision/alerts/response - see local_feed_
# evidence.py / local_feed_downloader.py's own module headers.
# LOCAL_FEED_SCHEDULER_ENABLED=false

# Where Local Feed snapshot/lock/attempt-state files live (one
# subdirectory per provider). Default: data/local_threat_feed next to
# the application - same convention as SECURITY_TELEMETRY_DIR above.
# LOCAL_THREAT_FEED_DIR=data/local_threat_feed
