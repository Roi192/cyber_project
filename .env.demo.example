# ==================================================
# Cyber Security Monitoring & Response Platform
# CLASSROOM DEMO environment configuration template
# ==================================================
# Copy this file to `.env.demo` in the same directory and fill in
# real (but still demo-only) values. Never commit the real
# `.env.demo` file. This file contains placeholders only - never
# copy actual values from your real `.env`.
#
#   cp .env.demo.example .env.demo        (Linux/Kali)
#   copy .env.demo.example .env.demo      (Windows)
#
# Used by: python prepare_demo_db.py --db-path cybersec_demo.db
#          --yes-reset-demo-db --env-file .env.demo
#
# See README "Classroom Demo Database" for the full explanation of
# cybersec.db (development) vs. cybersec_demo.db (classroom demo).

# Selects the demo database file instead of the development
# cybersec.db. Both the server (python app.py / gunicorn app:app)
# and the worker (python web_event_worker.py) must be started with
# this SAME value set, or they will operate on different databases.
SOC_DB_PATH=cybersec_demo.db

# 0.0.0.0 so both classroom Windows endpoints can reach the server
# over the LAN. Only do this on a trusted, isolated classroom
# network - see README "Network Binding for Lab Use".
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Never enable the debug reloader for the actual demo.
FLASK_DEBUG=false

# Plain HTTP classroom LAN - leave false (see README Limitations on
# why HTTP-only is acceptable for this scope and not production-safe).
FLASK_SECURE_COOKIES=false

# SIMULATED mode for the demo, by default. Only ever set true on an
# elevated, authorized lab Agent you control, and only after
# restore_network.py has been verified available on that machine.
ENABLE_RESPONSE_ACTIONS=false

# Generate real, demo-specific values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Do not reuse the development .env's real values here.
FLASK_SECRET_KEY=CHANGE_ME_DEMO
AGENT_API_KEY=CHANGE_ME_DEMO

# Optional - leave blank to skip that provider's enrichment.
VT_API_KEY=
ABUSEIPDB_API_KEY=

# Creates the one demo admin account on first initialization.
INITIAL_ADMIN_USERNAME=demo_admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_DEMO

# --------------------------------------------------
# Agent-side only - NOT read by the server or prepare_demo_db.py.
# Set this in each Windows demo PC's OWN .env instead, pointing at
# the SOC server's real LAN IP, e.g. http://192.168.1.50:5000.
# Documented here only so both files' variable names stay next to
# each other for reference.
# --------------------------------------------------
# SOC_SERVER_URL=http://<server-LAN-IP>:5000
