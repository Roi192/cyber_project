# /etc/soc-suricata-adapter/adapter.env
# Install with:  sudo install -m 0600 -o soc-adapter -g soc-adapter /dev/null /etc/soc-suricata-adapter/adapter.env
# Edit it with an editor (sudoedit). The adapter warns if group/other permission bits are set.
# Values are read VERBATIM: do not quote them, do not leave trailing spaces, and type the key with an
# English (US) keyboard layout (non-ASCII, quotes, whitespace and control characters in SENSOR_KEY are rejected, never repaired).
#
# --- Current LOCAL LAB (VirtualBox NAT: the guest reaches the host loopback at 10.0.2.2; plain HTTP never leaves the machine) ---
SOC_URL=http://10.0.2.2:5000
#
# --- OFF-BOX sensor (sensor and SOC on different machines): HTTPS is REQUIRED (docs/SURICATA_SENSOR_HARDENING.md, MODE 2) ---
# SOC_URL=https://soc.example.internal
# SOC_CA_FILE=/etc/soc-suricata-adapter/soc-ca.pem
# SOC_REQUIRE_HTTPS=true
#
SENSOR_ID=suricata-lab-1
# One-time secret printed by `sensor_admin.py create` on the SOC host. NEVER paste it into chat, tickets, shell history or a command line.
SENSOR_KEY=
SURICATA_EVE_PATH=/var/log/suricata/eve.json
SOC_ADAPTER_STATE_DIR=/var/lib/soc-suricata-adapter
# SURICATA_INCLUDE_DNS_REQUESTS=false
