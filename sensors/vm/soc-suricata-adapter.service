# SOC Suricata EVE adapter - hardened reference unit v2 (Phase 14C). REFERENCE ONLY: NOT installed by any project tool.
# Install as /etc/systemd/system/soc-suricata-adapter.service (see docs/SURICATA_SENSOR_HARDENING.md for the full,
# reviewed procedure, the user/group model, permissions and the rollback/uninstall commands).
#
# Credential handling: the unit and its command line contain ONLY the PATH of the env file. The adapter reads
# SENSOR_KEY from that file itself (verbatim, ASCII-validated), so the secret is never in argv, never in the unit,
# never in `systemctl show`, and - unlike EnvironmentFile= - not in the service's process environment.
[Unit]
Description=SOC Suricata EVE adapter (posts normalized EVE to the SOC ingest endpoint)
Documentation=file:/opt/soc-suricata-adapter/docs/SURICATA_SENSOR_HARDENING.md
After=network-online.target suricata.service
Wants=network-online.target
# Bounded restart behaviour: at most 5 starts per 5 minutes, then the unit stays `failed` and visible.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=soc-adapter
Group=soc-adapter
# Read access to EVE comes ONLY through this dedicated group (see the permission model in the doc).
SupplementaryGroups=soc-eve
# Preflight: refuses to start on a bad env file/credential/URL/CA file, an unwritable state dir or an EVE file this user cannot open.
ExecStartPre=/usr/bin/python3 /opt/soc-suricata-adapter/suricata_adapter.py check-config --env-file /etc/soc-suricata-adapter/adapter.env
ExecStart=/usr/bin/python3 /opt/soc-suricata-adapter/suricata_adapter.py run --env-file /etc/soc-suricata-adapter/adapter.env
# SIGTERM is a clean stop (finish the batch, save the checkpoint, exit 0) and is not restarted.
# Exit code 2 = configuration error: do not restart-loop on it.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2
TimeoutStopSec=45
# State (checkpoint.json, status.json): /var/lib/soc-suricata-adapter, mode 0700, owned by soc-adapter; survives reboots.
StateDirectory=soc-suricata-adapter
StateDirectoryMode=0700
UMask=0077
# Sandbox (no root, no capabilities, read-only view of the system, EVE readable but never writable)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Verify on the VM; remove ONLY this line if CPython on the sensor needs writable+executable memory.
MemoryDenyWriteExecute=yes
ReadOnlyPaths=/var/log/suricata
# Bounded resources (the adapter uses well under this: batches <= 100 lines / 256 KB).
MemoryMax=256M
TasksMax=32
# A hostname in SOC_URL needs the resolver: add AF_UNIX (and AF_NETLINK if required) to RestrictAddressFamilies above.
# Optional per-deployment egress pinning belongs in a drop-in (never hard-code an address here):
#   /etc/systemd/system/soc-suricata-adapter.service.d/10-egress.conf
#   [Service]
#   IPAddressDeny=any
#   IPAddressAllow=<SOC address>

[Install]
WantedBy=multi-user.target
